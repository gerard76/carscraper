<%= form_with(model: model) do |form| %>
  <% if model.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(model.errors.count, "error") %> prohibited this model from being saved:</h2>

      <ul>
        <% model.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :make %>
    <%= form.text_field :make %>
  </div>

  <div>
    <%= form.label :model %>
    <%= form.text_field :model %>
  </div>

  <div>
    <%= form.label :min_seats, "Minimum seats" %>
    <%= form.number_field :min_seats %>
    <small>Leave empty to keep every version. Set it to 4 and listings that
    advertise fewer seats than that are skipped, which is how the cargo van is
    told apart. Listings that do not mention their seats are always kept.</small>
  </div>

  <div>
    <%= form.label :exclude_versions, "Exclude versions" %>
    <%= form.text_field :exclude_versions %>
    <small>Comma separated. Listings whose version mentions one of these are
    skipped while scraping, e.g. "ID.3, ID.4, ID.5" for an ID. Buzz.</small>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
