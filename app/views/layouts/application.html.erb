<!DOCTYPE html>
<html>
  <head>
    <title>Carscraper</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= javascript_importmap_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Albert Sans, as on evkenniscentrum.nl. Falls back to the system sans
        when there is no network. %>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600&display=swap", media: "all" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= render "layouts/nav" %>

    <main>
      <p class="notice"><%= notice %></p>
      <%= yield %>
    </main>
  </body>
</html>


