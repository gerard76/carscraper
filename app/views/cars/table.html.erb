<%= render 'search_form', url: table_cars_path %>

<%# The whole answer first, then which of it is in front of you. %>
<p class="count">
  <%= pluralize(@total, "car") %><%= ", #{@from}&ndash;#{@to} shown".html_safe if @pages > 1 %>
</p>

<table class="cars">
  <thead>
    <tr>
      <%# page: nil on every one of them. sort_link builds its url out of the
          parameters you arrived with, so sorting from page 12 would sort the
          list and leave you standing on page 12 of it -- which is a different
          set of cars than the one you were looking at. A new order is a new
          list, and you want the top of it. %>
      <th class="starred"><%= sort_link(@q, :favourite, "★", page: nil) %></th>
      <th>Title</th>
      <th class="right"><%= sort_link(@q, :year, "Built", page: nil) %></th>
      <th class="right"><%= sort_link(@q, :km, "Km", page: nil) %></th>
      <th class="right"><%= sort_link(@q, :landed_eur, "Price", page: nil) %></th>
      <th class="right"><%= sort_link(@q, :bargain_eur, "Bargain", page: nil) %></th>
      <th class="right"><%= sort_link(@q, :distance_km, "Distance", page: nil) %></th>
      <%# Newest first on the first click: that is what you want from it. %>
      <th class="right" title="Days since the scrape that first found it">
        <%= sort_link(@q, :created_at, "New", default_order: :desc, page: nil) %>
      </th>
      <th>Where</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @cars.each do |car| %>
      <tr>
        <td class="starred"><%= render "star", car: car %></td>
        <td class="title">
          <%# The ad's own title. The model is the same on every row -- it is
              what you searched for -- so it only shows when it is all there is.
              Sellers write titles of any length, so the cell cuts it off with
              an ellipsis and keeps the whole thing for the tooltip. %>
          <% title = car.title %>
          <%= link_to title, car, title: title %>
        </td>
        <td class="right"><%= car.year.strftime("%Y-%m") %></td>
        <td class="right"><%= number_with_delimiter car.km %></td>
        <td class="right">
          <%# The note goes in front of the price: the column is right aligned,
              so anything after it pushes the number out of line with the rest. %>
          <% if car.import_costs > 0 %>
            <span class="import" title="<%= number_to_currency car.eur, unit: "€", precision: 0 %> plus <%= number_to_currency car.import_costs, unit: "€", precision: 0 %> to import it">incl. import</span>
          <% end %>
          <%= number_to_currency car.landed_eur, unit: "€", precision: 0 %>
        </td>
        <td class="right">
          <%# How much less it asks than comparable cars of its age and
              mileage. Blank until Car.recalculate_bargains! has run. %>
          <% if car.bargain_eur %>
            <span class="<%= car.bargain_eur.positive? ? "cheap" : "dear" %>"
                  title="comparable cars of this age and mileage ask <%= number_to_currency car.landed_eur + car.bargain_eur, unit: "€", precision: 0 %>">
              <%= number_to_currency car.bargain_eur, unit: "€", precision: 0, format: car.bargain_eur.positive? ? "+%u%n" : "%u%n" %>
            </span>
          <% end %>
        </td>
        <td class="right"><%= "#{number_with_delimiter car.distance_km} km" if car.distance_km %></td>
        <td class="right" title="First seen <%= car.created_at.to_date.strftime("%-d %B") %>">
          <%= car.days_online.zero? ? "today" : "#{car.days_online}d" %>
        </td>
        <td><%= car.location %></td>
        <td>
          <%# The listing itself, on the site it came from. %>
          <%= link_to car.url, target: "_blank", rel: "noopener", title: "Open this listing on #{car.source}" do %>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
            </svg>
            <span class="visually-hidden">Open on <%= car.source %></span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "pages" %>

<style>
  table.cars {
    border-collapse: collapse;
    font-size: 14px;
  }
  table.cars th, table.cars td {
    padding: 4px 10px;
    border-bottom: 1px solid #ddd;
    text-align: left;
    white-space: nowrap;
  }
  table.cars th {
    position: sticky;
    top: 0;
    background: #fff;
    border-bottom: 2px solid #999;
  }
  table.cars .right, table.cars th.right {
    text-align: right;
  }
  /* Figures in Figtree so they line up down the column -- see --figures. */
  table.cars td.right {
    font-family: var(--figures);
    font-variant-numeric: tabular-nums;
  }
  table.cars tr:hover td {
    background: #f4f4f4;
  }
  /* Nine in ten titles fit in 52 characters; the longest in here runs to 722. */
  table.cars .starred {
    width: 1.6em;
    text-align: center;
    padding-right: 0;
  }
  table.cars td.title {
    max-width: 52ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  table.cars .cheap {
    color: #0a0;
  }
  table.cars .dear {
    color: #a00;
  }
  table.cars .import {
    color: #888;
    font-size: 11px;
    white-space: nowrap;
  }
  table.cars svg {
    vertical-align: middle;
    color: #06c;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
