<%= render 'search_form', url: cars_path %>
<p><%= link_to "Table", table_cars_path(q: search_query) %> &middot; <%= link_to "Photos", photos_cars_path(q: search_query) %></p>

<div id="chart" style="width: 1024px; height: 768px;"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const chartDom = document.getElementById('chart');
  const myChart = echarts.init(chartDom, 'dark');

  const data = <%= raw @data.to_json %>;
  const unmeasured = <%= raw @unmeasured.to_json %>;

  const series = [
    { name: 'Cars', type: 'scatter', data: data, symbolSize: 10 },
    {
      name: 'Trend',
      type: 'line',
      data: <%= raw @trendline.to_json %>,
      symbol: 'none',
      lineStyle: { color: '#eceff1', width: 2 },
      tooltip: { show: false }
    }
  ];

  // The seller did not say what the odometer reads, so there is nothing to say
  // about how hard this one has been driven. Drawn as a ring: there are only a
  // handful of these and a filled grey dot disappears between its neighbours.
  if (unmeasured.length) {
    series.push({
      name: 'Mileage unknown',
      type: 'scatter',
      data: unmeasured,
      symbolSize: 13,
      itemStyle: { color: 'transparent', borderColor: '#b0bec5', borderWidth: 2 }
    });
  }

  const option = {
    title: {
      text: 'Car Prices by Year',
      subtext: 'Price includes an estimate of what it costs to import the car. Under the line and green is cheap for its build year without having been driven hard.'
    },
    legend: {
      show: unmeasured.length > 0,
      data: ['Mileage unknown'],
      right: 10,
      top: 0
    },
    // Room at the top so the y axis name clears the subtitle.
    grid: { top: 90 },
    tooltip: {
      trigger: 'item',
      formatter: function(params) {
        const date = new Date(params.data.value[0]);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0'); // maand 0–11

        let price = `Price: ${params.data.value[1].toLocaleString()}`;
        if (params.data.import > 0) {
          price += ` (${params.data.asked.toLocaleString()} + ${params.data.import.toLocaleString()} import)`;
        }

        let text = `
          ${params.data.type}<br>
          Year: ${year}-${month}<br>
          ${price}<br>
          KM: ${params.data.km}<br>
          ${params.data.version}
        `;

        if (params.data.value[2] !== null && params.data.value[2] !== undefined) {
          text += `<br>${params.data.value[2]} km/year`;
        }

        if (params.data.distance) {
          text += `<br>${params.data.distance.toLocaleString()} km away`;
        }

        if (params.data.bargain) {
          const b = params.data.bargain;
          text += `<br>${Math.abs(b).toLocaleString()} ${b > 0 ? "under" : "over"} what its age and mileage suggest`;
        }

         if (params.data.comments && params.data.comments.trim() !== "") {
          text += `<br><br>${params.data.comments}`;
        }

        return text;
      }
    },
    xAxis: {
      name: 'Year',
      type: 'time'
    },
    yAxis: {
      name: 'Price incl. import',
      type: 'value',
      min: <%= @floor.round %>
    },
    series: series
  };

  myChart.setOption(option);

  // Make dots clickable
  myChart.on('click', function(params) {
    if (params.data.url) {
      window.location.href = params.data.url;
    }
  });
});
</script>