<%= render 'search_form' %>

<div id="chart" style="width: 1024px; height: 768px;"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const chartDom = document.getElementById('chart');
  const myChart = echarts.init(chartDom, 'dark');

  const data = <%= raw @data.to_json %>;
  const unmeasured = <%= raw @unmeasured.to_json %>;
  const wear = { low: <%= @wear[0].round %>, high: <%= @wear[1].round %> };

  // Colour runs over mileage per year. Drag the handles on the bar to keep
  // only part of that range in colour.
  const scale = ['#00e676', '#76ff03', '#c6ff00', '#ffee58', '#ffc400', '#ff6d00', '#ff1744'];

  const series = [
    { name: 'Cars', type: 'scatter', data: data, symbolSize: 10 },
    {
      name: 'Trend',
      type: 'line',
      data: <%= raw @trendline.to_json %>,
      symbol: 'none',
      lineStyle: { color: '#eceff1', width: 2 },
      tooltip: { show: false }
    }
  ];

  // The seller did not say what the odometer reads, so there is nothing to say
  // about how hard this one has been driven. Drawn as a ring: there are only a
  // handful of these and a filled grey dot disappears between its neighbours.
  if (unmeasured.length) {
    series.push({
      name: 'Mileage unknown',
      type: 'scatter',
      data: unmeasured,
      symbolSize: 13,
      itemStyle: { color: 'transparent', borderColor: '#b0bec5', borderWidth: 2 }
    });
  }

  const option = {
    title: {
      text: 'Car Prices by Year',
      subtext: 'Under the line is cheap for its build year. Green as well, and it is cheap without having been driven hard.'
    },
    legend: {
      show: unmeasured.length > 0,
      data: ['Mileage unknown'],
      right: 130,
      top: 0
    },
    grid: { right: 120 },
    visualMap: wear.high > wear.low ? [{
      type: 'continuous',
      // The third value of every point, set in CarsController#point.
      dimension: 2,
      seriesIndex: 0,
      min: wear.low,
      max: wear.high,
      calculable: true,
      right: 10,
      top: 'middle',
      itemHeight: 240,
      text: ['driven hard', 'gently used'],
      formatter: (value) => Math.round(value).toLocaleString() + ' km/year',
      inRange: { color: scale }
    }] : [],
    tooltip: {
      trigger: 'item',
      formatter: function(params) {
        const date = new Date(params.data.value[0]);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0'); // maand 0–11

        let text = `
          ${params.data.type}<br>
          Year: ${year}-${month}<br>
          Price: ${params.data.value[1]}<br>
          KM: ${params.data.km}<br>
          ${params.data.version}
        `;

        if (params.data.value[2] !== null && params.data.value[2] !== undefined) {
          text += `<br>${params.data.value[2]} km/year`;
        }

         if (params.data.comments && params.data.comments.trim() !== "") {
          text += `<br><br>${params.data.comments}`;
        }

        return text;
      }
    },
    xAxis: {
      name: 'Year',
      type: 'time'
    },
    yAxis: {
      name: 'Price',
      type: 'value',
      min: <%= (@cars.minimum(:eur) || 1000) - 1000 %>
    },
    series: series
  };

  myChart.setOption(option);

  // Make dots clickable
  myChart.on('click', function(params) {
    if (params.data.url) {
      window.location.href = params.data.url;
    }
  });
});
</script>