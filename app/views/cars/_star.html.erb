<%# One click to mark a car worth coming back to, and the same click to
    unmark it. The filters can then show nothing else. %>
<% label = car.favourite ? "Take the star off" : "Star this one" %>
<%= button_to favourite_car_path(car), method: :patch, form_class: "star-form",
      class: "star#{" on" if car.favourite}", title: label, aria: { label: label } do %>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
       fill="<%= car.favourite ? "currentColor" : "none" %>"
       stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M12 3.6l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8-5.4 2.8 1-6-4.3-4.2 6-.9z" />
  </svg>
<% end %>
