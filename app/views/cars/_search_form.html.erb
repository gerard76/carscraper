<%= search_form_for @q, url: local_assigns.fetch(:url, cars_path) do |f| %>
  <%= f.label :models %>
  <%= f.select :model_id_in,
    options_from_collection_for_select(Model.all, :id, :type, @q.model_id_in),
    {include_blank: "Any"}, { multiple: true, size: 1} %>

  <%# Bargain compares a car to every other car, trim and all, so narrowing to
      one trim first is what makes that number mean something. %>
  <%= f.label :version_cont, "Title contains" %>
  <%= f.search_field :version_cont %>

  <label for="q_landed_eur_lteq">Eur max (incl. import)</label>
  <%= f.search_field :landed_eur_lteq %>

  <%= f.label :km_max %>
  <%= f.search_field :km_lteq %>

  <label for="q_distance_km_lteq">Km from home max</label>
  <%= f.search_field :distance_km_lteq %>

  <label for="q_year_min">Year from</label>
  <input type="text" name="q[year_min]" id="q_year_min" value="<%= params.dig(:q, :year_min) %>">

  <%= f.label :country %>
  <%= f.select :country_eq,
        options_for_select([["Austria","a"],["Spain","e"],["Germany","d"],["Belgium","b"],["Luxembourg","l"],["France","f"],["Netherlands","nl"],["Norway","no"]], @q.country_eq),
        include_blank: "Any" %>

  <%= f.submit %>

<% end %>