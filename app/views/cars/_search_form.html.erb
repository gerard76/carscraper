<%= search_form_for @q, url: local_assigns.fetch(:url, cars_path), html: { class: "filters" } do |f| %>
  <div class="filter">
    <%= f.label :models %>
    <%= f.select :model_id_in,
      options_from_collection_for_select(Model.all, :id, :short_type, @q.model_id_in),
      { include_blank: "Any", include_hidden: false }, { multiple: true, size: 1 } %>
  </div>

  <%# Bargain compares a car to every other car, trim and all, so narrowing to
      one trim first is what makes that number mean something. %>
  <div class="filter">
    <%= f.label :version_cont, "Title contains" %>
    <%= f.search_field :version_cont %>
  </div>

  <%# Read off the listing's own page rather than guessed from its title, so
      these only offer the counts that are actually in front of you. Blank on a
      car means the advert never said, not that it has none. %>
  <%# More than one at a time, all three: six seats or seven is one question,
      and so is 79 kWh or 86.

      include_hidden: false, or every submit carries a blank whether or not you
      picked one -- Rails puts one in front of a multiple select so that
      clearing the last pick still sends something. With "Any" meaning "forget
      this field" (see CarsController#asked_for), that blank cleared the field
      on every search: tick 6, press Search, get everything. Without it, an
      empty select simply sends nothing, which says the same thing. %>
  <div class="filter">
    <%= f.label :seats_in, "Seats" %>
    <%= f.select :seats_in, options_for_select(stated_options(:seats), chosen_many(:seats)),
          { include_blank: "Any", include_hidden: false }, { multiple: true, size: 1 } %>
  </div>

  <div class="filter">
    <%= f.label :kwh_in, "Battery kWh" %>
    <%= f.select :kwh_in, options_for_select(stated_options(:kwh), chosen_many(:kwh)),
          { include_blank: "Any", include_hidden: false }, { multiple: true, size: 1 } %>
  </div>

  <%# What the battery used to stand in for, asked directly: two in five titles
      say "langer Radstand", LR or LWB, and 168 of those name no battery at
      all. See Car.wheelbase_in. %>
  <div class="filter">
    <%= f.label :wheelbase_in, "Wheelbase" %>
    <%= f.select :wheelbase_in,
          options_for_select(stated_options(:wheelbase, labels: { "long" => "Long", "short" => "Short" }), chosen_many(:wheelbase)),
          { include_blank: "Any", include_hidden: false }, { multiple: true, size: 1 } %>
  </div>

  <div class="filter">
    <%= f.label :landed_eur_lteq, "Eur max" %>
    <%= f.search_field :landed_eur_lteq, placeholder: "incl. import" %>
  </div>

  <div class="filter">
    <%= f.label :km_lteq, "Km max" %>
    <%= f.search_field :km_lteq %>
  </div>

  <div class="filter">
    <%= f.label :distance_km_lteq, "Km from home" %>
    <%= f.search_field :distance_km_lteq, placeholder: "max" %>
  </div>

  <div class="filter">
    <label for="q_year_min">Year from</label>
    <input type="text" name="q[year_min]" id="q_year_min" value="<%= search_query&.dig("year_min") %>">
  </div>

  <div class="filter">
    <%= f.label :country_eq, "Country" %>
    <%= f.select :country_eq,
          options_for_select([["Austria", "a"], ["Spain", "e"], ["Germany", "d"], ["Belgium", "b"], ["Luxembourg", "l"], ["France", "f"], ["Netherlands", "nl"], ["Norway", "no"]], @q.country_eq),
          include_blank: "Any" %>
  </div>

  <%# Ticked, nothing but the starred ones. Unticked it sends nothing at all
      (include_hidden would otherwise send "0" and ask for the rest). %>
  <div class="filter tick">
    <%= f.label :favourite_eq, "Starred only" %>
    <%= f.check_box :favourite_eq, { include_hidden: false }, "true" %>
  </div>

  <div class="filter actions">
    <%= f.submit "Search" %>
    <% if search_query.present? %>
      <%# The plain path now means "what you had last time", so clearing has to
          ask for it: this is the only thing that forgets the filter. %>
      <%= link_to "Clear", "#{local_assigns.fetch(:url, cars_path)}?clear=1", class: "clear" %>
    <% end %>
  </div>
<% end %>
