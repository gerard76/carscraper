<%= search_form_for @q, url: local_assigns.fetch(:url, cars_path), html: { class: "filters" } do |f| %>
  <div class="filter">
    <%= f.label :models %>
    <%= f.select :model_id_in,
      options_from_collection_for_select(Model.all, :id, :short_type, @q.model_id_in),
      { include_blank: "Any" }, { multiple: true, size: 1 } %>
  </div>

  <%# Bargain compares a car to every other car, trim and all, so narrowing to
      one trim first is what makes that number mean something. %>
  <div class="filter">
    <%= f.label :version_cont, "Title contains" %>
    <%= f.search_field :version_cont %>
  </div>

  <%# Read off the listing's own page rather than guessed from its title, so
      these only offer the counts that are actually in front of you. Blank on a
      car means the advert never said, not that it has none. %>
  <div class="filter">
    <%= f.label :seats_eq, "Seats" %>
    <%= f.select :seats_eq, options_for_select(stated_options(:seats), chosen(:seats)),
          include_blank: "Any" %>
  </div>

  <div class="filter">
    <%= f.label :kwh_eq, "Battery kWh" %>
    <%= f.select :kwh_eq, options_for_select(stated_options(:kwh), chosen(:kwh)),
          include_blank: "Any" %>
  </div>

  <%# What the battery used to stand in for, asked directly: two in five titles
      say "langer Radstand", LR or LWB, and 168 of those name no battery at
      all. See Car.wheelbase_in. %>
  <div class="filter">
    <%= f.label :wheelbase_eq, "Wheelbase" %>
    <%= f.select :wheelbase_eq,
          options_for_select(stated_options(:wheelbase, labels: { "long" => "Long", "short" => "Short" }), chosen(:wheelbase)),
          include_blank: "Any" %>
  </div>

  <div class="filter">
    <%= f.label :landed_eur_lteq, "Eur max" %>
    <%= f.search_field :landed_eur_lteq, placeholder: "incl. import" %>
  </div>

  <div class="filter">
    <%= f.label :km_lteq, "Km max" %>
    <%= f.search_field :km_lteq %>
  </div>

  <div class="filter">
    <%= f.label :distance_km_lteq, "Km from home" %>
    <%= f.search_field :distance_km_lteq, placeholder: "max" %>
  </div>

  <div class="filter">
    <label for="q_year_min">Year from</label>
    <input type="text" name="q[year_min]" id="q_year_min" value="<%= params.dig(:q, :year_min) %>">
  </div>

  <div class="filter">
    <%= f.label :country_eq, "Country" %>
    <%= f.select :country_eq,
          options_for_select([["Austria", "a"], ["Spain", "e"], ["Germany", "d"], ["Belgium", "b"], ["Luxembourg", "l"], ["France", "f"], ["Netherlands", "nl"], ["Norway", "no"]], @q.country_eq),
          include_blank: "Any" %>
  </div>

  <%# Ticked, nothing but the starred ones. Unticked it sends nothing at all
      (include_hidden would otherwise send "0" and ask for the rest). %>
  <div class="filter tick">
    <%= f.label :favourite_eq, "Starred only" %>
    <%= f.check_box :favourite_eq, { include_hidden: false }, "true" %>
  </div>

  <div class="filter actions">
    <%= f.submit "Search" %>
    <% if search_query.present? %>
      <%= link_to "Clear", local_assigns.fetch(:url, cars_path), class: "clear" %>
    <% end %>
  </div>
<% end %>
