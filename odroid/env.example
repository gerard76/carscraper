# Copy to /opt/carscraper/.env on the Odroid, mode 600, and fill in.
# The same four values .kamal/secrets names; read them out with
#   .kamal/read-secret database.password     (and so on)
# Never commit the filled-in copy: this repository is public.
CARSCRAPER_DATABASE_PASSWORD=
SECRET_KEY_BASE=
HOME_LATITUDE=
HOME_LONGITUDE=
