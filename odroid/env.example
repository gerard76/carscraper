# Copy to /opt/carscraper/.env on the Odroid, mode 600, and fill in.
#
# DROPLET_HOST is the server this box dials: the address or hostname the app
# is deployed to, the same one config/deploy.yml names. It is asked for here
# rather than written into docker-compose.yml because that file is in git.
#
# The rest are the values .kamal/secrets names; read them out with
#   .kamal/read-secret database.password     (and so on)
# Never commit the filled-in copy: this repository is public.
DROPLET_HOST=
CARSCRAPER_DATABASE_PASSWORD=
SECRET_KEY_BASE=
HOME_LATITUDE=
HOME_LONGITUDE=
