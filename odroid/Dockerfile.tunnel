# The outbound half of the arrangement: this dials the droplet, the droplet
# never dials us. See odroid/README.md for why that direction is the whole
# point.
FROM alpine:3.21

RUN apk add --no-cache openssh-client autossh

# Not root. The key is mounted read-only and owned by this uid on the host.
RUN adduser -D -u 1000 tunnel
USER 1000:1000

# -M 0 turns off autossh's own monitoring port and leaves the liveness check
# to ssh itself, which is the better judge: ServerAliveInterval notices a
# connection whose far end has died, which is exactly the failure that once
# sailed past a port check in mise.toml and fell over later looking like a
# broken database.
#
# ExitOnForwardFailure for the same reason: without it ssh connects happily
# when the port is already taken, reports success, and the scrape fails a
# minute later for a reason that looks like something else entirely.
ENTRYPOINT ["autossh", "-M", "0", "-N", \
  "-o", "ServerAliveInterval=30", \
  "-o", "ServerAliveCountMax=3", \
  "-o", "ExitOnForwardFailure=yes", \
  "-o", "StrictHostKeyChecking=yes", \
  "-o", "UserKnownHostsFile=/keys/known_hosts", \
  "-o", "IdentitiesOnly=yes", \
  "-o", "ForwardAgent=no", \
  "-o", "ForwardX11=no", \
  "-i", "/keys/id_scraper"]
