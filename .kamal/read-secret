#!/bin/bash
# read-secret NAME -- prints one secret and nothing else.
#
# The environment wins, so a one-off deploy can pass a value inline:
#
#   CARSCRAPER_PASSWORD=iets bin/kamal deploy
#
# Otherwise it comes from .kamal/secrets.local, a plain NAME=value file that
# is not in git. That file is the only copy of these values, so keep it in
# 1Password as well -- README.md says which names it needs.
#
# A value that is not there prints as nothing rather than failing here. The
# pre-connect hook checks them all at once and names the ones that are
# missing, which beats what docker says when it is handed an empty password:
# "flag needs an argument: 'p' in -p".
set -uo pipefail

name=${1:?read-secret needs the name of a secret}
value=${!name:-}

if [ -z "$value" ] && [ -f .kamal/secrets.local ]; then
  value=$(sed -n "s/^[[:space:]]*${name}=//p" .kamal/secrets.local | tail -n 1)
  value=${value%\"}
  value=${value#\"}
fi

printf '%s' "$value"
