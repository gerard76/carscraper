#!/bin/bash
# read-secret PATH -- prints one value out of config/credentials.yml.enc.
#
#   .kamal/read-secret kamal.registry_password
#
# Every secret this project has lives in the credentials and nowhere else.
# Edit them with:
#
#   bin/rails credentials:edit
#
# It reads the file directly rather than through `bin/rails runner`, which
# would boot Rails once per secret and add half a minute to every deploy.
#
# Through mise when it is there, because the ruby that can load this app's
# activesupport is the one mise.toml pins -- /usr/bin/ruby is not it.
#
# A value that is not there prints as nothing rather than failing here. The
# pre-connect hook checks them all at once and names the ones that are
# missing, which beats what docker says when it is handed an empty password:
# "flag needs an argument: 'p' in -p".
set -uo pipefail

path=${1:?read-secret needs the path of a secret, e.g. kamal.registry_user}

read_secret='
require "bundler/setup"
require "active_support"
require "active_support/encrypted_configuration"

credentials = ActiveSupport::EncryptedConfiguration.new(
  config_path: "config/credentials.yml.enc",
  key_path: "config/master.key",
  env_key: "RAILS_MASTER_KEY",
  raise_if_missing_key: true
)

print credentials.dig(*ARGV[0].split(".").map(&:to_sym))
'

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- ruby -e "$read_secret" "$path"
else
  exec ruby -e "$read_secret" "$path"
fi
