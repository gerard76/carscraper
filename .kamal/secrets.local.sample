# Copy to .kamal/secrets.local (which is not in git) and fill in. Every name
# here is read by .kamal/secrets through .kamal/read-secret, and pre-connect
# refuses to deploy while one of them is empty.
#
# This file is the only copy of these values, so keep it in 1Password too.

# From DigitalOcean: API & Tokens -> a container registry token with read and
# write. The username is the token itself for a personal access token, or the
# email you log in with.
KAMAL_REGISTRY_USER=
KAMAL_REGISTRY_PASSWORD=

# Anything long and random; `openssl rand -hex 64`. Losing it logs everybody out.
SECRET_KEY_BASE=

# The password postgres is created with and the app connects with. Change it
# and the accessory has to be recreated, not just redeployed.
CARSCRAPER_DATABASE_PASSWORD=

# What you and Mila type before a click that changes something. Looking needs
# nothing. Leave it empty and nothing is locked at all.
CARSCRAPER_PASSWORD=

# Where the distances are measured from. The middle of a village is plenty --
# see app/models/home.rb.
HOME_LATITUDE=
HOME_LONGITUDE=
