#!/bin/bash
set -eo pipefail

# Migrate before any container boots, rather than from inside one.
#
# bin/docker-entrypoint does run db:prepare, but only for the web role, and
# only as the new container starts -- so the schema changes while the old
# container is still answering. Doing it here is the same work a moment
# earlier, where a failure stops the deploy instead of half-finishing it.
#
# db:prepare rather than db:migrate, so the very first deploy creates the
# database and loads the schema instead of failing on a database that is not
# there yet.
#
# --version is load-bearing. Without it `kamal app exec` runs :latest, and the
# docker daemon on the server serves the :latest it already has rather than
# pulling: the migration then "succeeds" in seconds having run the previous
# image, and nothing says so.
#
# ⚠️ A destructive migration must not ship in the same deploy as the code that
# still runs against it. The migration below lands before any container is
# replaced, so the old job container -- which may be halfway through a scrape,
# writing to every column there is -- meets the new schema on old code for the
# length of the boot. An add_column is safe there; a remove or a rename is not.
#
# ALLOW_DESTRUCTIVE_MIGRATION=1 says the deployed code no longer touches it.
added=$(git diff --name-only --diff-filter=A HEAD~1 HEAD -- db/migrate 2>/dev/null || true)
if [ -z "$ALLOW_DESTRUCTIVE_MIGRATION" ] && [ -n "$added" ]; then
  destructive=$(grep -lE '^[[:space:]]*(remove_column|rename_column|drop_table|rename_table)' $added || true)
  if [ -n "$destructive" ]; then
    echo "✗ REFUSING TO DEPLOY: a destructive migration is shipping alongside code that still runs against it." >&2
    printf '   %s\n' $destructive >&2
    echo "   Ship the code that stops reading it first, then the removal." >&2
    echo "   ALLOW_DESTRUCTIVE_MIGRATION=1 overrides once the old code is gone." >&2
    exit 1
  fi
fi

# On the very first deploy there is nothing to run this with: kamal uploads the
# role's env file while it boots the app, which is after this hook, so
# `kamal app exec` has no --env-file to point at and docker exits 125. It is
# also the one deploy that does not need this, because bin/docker-entrypoint
# runs db:prepare as the container starts.
running=$(bin/kamal app version 2>/dev/null |
          grep -Ev '^App Host:|^\s*(INFO|DEBUG|ERROR)|^\s*$' | tail -n 1 | tr -d '[:space:]') || true

if [ -z "$running" ]; then
  echo "Nothing running there yet, so this is the first deploy: the entrypoint prepares the database as the container starts."
  exit 0
fi

echo "Preparing the database on version $KAMAL_VERSION..."
if ! bin/kamal app exec --version="$KAMAL_VERSION" --roles=web --primary "bin/rails db:prepare"; then
  echo "✗ The database could not be prepared, so nothing was booted." >&2
  echo "  Usually one of: the postgres accessory is not running (bin/kamal accessory boot postgres)," >&2
  echo "  or CARSCRAPER_DATABASE_PASSWORD here and POSTGRES_PASSWORD in the accessory have drifted apart." >&2
  exit 1
fi
