#!/bin/bash
set -eo pipefail

# Two things break a deploy before it has done anything, and both are cheap to
# check from here.
#
# 1. A secret with no value. Kamal does not mind an empty string, docker does,
#    and what it says is "flag needs an argument: 'p' in -p".
# 2. The name in config/deploy.yml not pointing at this server. kamal-proxy
#    then asks Let's Encrypt for a certificate it cannot be given, and the
#    site answers 502 with nothing in the logs to explain it.

# Everything comes out of config/credentials.yml.enc, so without its key
# nothing can be read at all -- and what the reader says then is a ruby
# backtrace.
if [ ! -f config/master.key ] && [ -z "$RAILS_MASTER_KEY" ]; then
  echo "✗ config/master.key is not here, so none of the secrets can be read." >&2
  echo "  It is not in git on purpose. Put it back, or pass it as RAILS_MASTER_KEY." >&2
  exit 1
fi

missing=()
for path in kamal.registry_user kamal.registry_password secret_key_base \
            database.password home.latitude home.longitude; do
  [ -n "$(.kamal/read-secret "$path")" ] || missing+=("$path")
done

if [ ${#missing[@]} -gt 0 ]; then
  echo "✗ No value for: ${missing[*]}" >&2
  echo "  bin/rails credentials:edit" >&2
  echo "  README.md lists what each one is." >&2
  exit 1
fi

# The deployment settings config/deploy.yml takes from the environment. Left
# unset, they are still the example values in that file and the deploy goes to
# somebody else's hostname.
case "$KAMAL_HOSTS" in
  *your.server.example.com*)
    echo "✗ DEPLOY_HOST is not set, so this would deploy to the example server." >&2
    echo "  config/deploy.yml lists the four DEPLOY_* settings and what they are." >&2
    exit 1 ;;
esac

# Allowed to be empty, but then the site is a free-for-all, so say so out loud.
if [ -z "$(.kamal/read-secret auth.password)" ]; then
  echo "⚠️  auth.password is empty: anyone who finds the site can cross cars away."
fi

# Through ERB, because config/deploy.yml takes the domain from the
# environment -- YAML.load_file alone would hand back the unrendered tag.
host=$(ruby -rerb -ryaml -e 'puts YAML.load(ERB.new(File.read("config/deploy.yml"), trim_mode: "-").result).dig("proxy", "host").to_s' 2>/dev/null || true)

if [ -z "$host" ]; then
  echo "⚠️  Could not read proxy/host out of config/deploy.yml, so the DNS check was skipped."
elif ! command -v dig >/dev/null; then
  echo "⚠️  No dig here, so the DNS check for $host was skipped."
else
  resolved=$(dig +short "$host" A | tail -n 1)
  if [ -z "$resolved" ]; then
    echo "✗ $host does not resolve. Give it an A record pointing at ${KAMAL_HOSTS%%,*} first:" >&2
    echo "  without it kamal-proxy cannot get a certificate and the site stays on 502." >&2
    exit 1
  fi
  case ",$KAMAL_HOSTS," in
    *",$resolved,"*) echo "✓ $host resolves to $resolved" ;;
    *) echo "✗ $host resolves to $resolved, but this deploy goes to $KAMAL_HOSTS." >&2
       echo "  Fix the A record, or the certificate will be issued for a server that is not this one." >&2
       exit 1 ;;
  esac
fi
