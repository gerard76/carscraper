# Read by kamal at deploy time. There are no values in here on purpose: every
# line asks .kamal/read-secret for one out of config/credentials.yml.enc,
# whose key is config/master.key and is not in git.
#
#   bin/rails credentials:edit
#
# This file IS in git, and this repository is public. Keep it that way: no
# passwords, no coordinates, nothing but the names.
# Whatever container registry config/deploy.yml pushes to. For a token that
# is its own username -- some registries work that way -- put the same value
# under both names.
KAMAL_REGISTRY_USER=$(.kamal/read-secret kamal.registry_user)
KAMAL_REGISTRY_PASSWORD=$(.kamal/read-secret kamal.registry_password)

# Rails needs this to sign cookies. Any long random string; losing it only
# logs everybody out.
SECRET_KEY_BASE=$(.kamal/read-secret secret_key_base)

# The database password, which the app and the accessory have to agree on --
# hence the same value twice under two names.
CARSCRAPER_DATABASE_PASSWORD=$(.kamal/read-secret database.password)
POSTGRES_PASSWORD=$(.kamal/read-secret database.password)

# What anyone allowed to change something types first. Looking needs nothing.
# Leave it empty and nothing is locked at all.
CARSCRAPER_PASSWORD=$(.kamal/read-secret auth.password)

# Where the distances are measured from: the middle of a village, not a house.
HOME_LATITUDE=$(.kamal/read-secret home.latitude)
HOME_LONGITUDE=$(.kamal/read-secret home.longitude)
