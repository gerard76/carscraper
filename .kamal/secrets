# Read by kamal at deploy time. There are no values in here on purpose: every
# line asks .kamal/read-secret, which takes the value from the environment if
# it is set and otherwise from .kamal/secrets.local, which is not in git.
#
# This file IS in git, and this repository is public. Keep it that way: no
# passwords, no coordinates, nothing but the names.
KAMAL_REGISTRY_USER=$(.kamal/read-secret KAMAL_REGISTRY_USER)
KAMAL_REGISTRY_PASSWORD=$(.kamal/read-secret KAMAL_REGISTRY_PASSWORD)

# Rails needs this to sign cookies. Any long random string; losing it only
# logs everybody out.
SECRET_KEY_BASE=$(.kamal/read-secret SECRET_KEY_BASE)

# The database password, which the app and the accessory have to agree on --
# hence the same value twice under two names.
CARSCRAPER_DATABASE_PASSWORD=$(.kamal/read-secret CARSCRAPER_DATABASE_PASSWORD)
POSTGRES_PASSWORD=$(.kamal/read-secret CARSCRAPER_DATABASE_PASSWORD)

# What Mila types before she can cross a car away. Looking needs nothing.
CARSCRAPER_PASSWORD=$(.kamal/read-secret CARSCRAPER_PASSWORD)

# Where the distances are measured from: the middle of a village, not a house.
HOME_LATITUDE=$(.kamal/read-secret HOME_LATITUDE)
HOME_LONGITUDE=$(.kamal/read-secret HOME_LONGITUDE)
