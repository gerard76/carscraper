<?xml version="1.0" encoding="UTF-8"?>
<!--
  The two sources the droplet cannot reach.

  AutoScout24 and AutoTrack answer 403 to the droplet -- CloudFront turning
  away a data centre address -- and between them they carry more than half the
  cars. This machine they answer, so the round that keeps them on the pages has
  to run here.

  Once a day is enough: Car::SEEN_WINDOW is three days, so two missed runs are
  survivable. launchd runs a missed job when the machine next wakes, which is
  the behaviour that makes this work on a laptop.

  Install:
    cp config/launchd/nl.diamondbay.carscraper.scrape.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/nl.diamondbay.carscraper.scrape.plist

  Run it once by hand:  launchctl start nl.diamondbay.carscraper.scrape
  Stop it for good:     launchctl unload ~/Library/LaunchAgents/nl.diamondbay.carscraper.scrape.plist
  What it did:          tail -f log/scrape-production.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.diamondbay.carscraper.scrape</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/gerard/.local/bin/mise</string>
    <string>run</string>
    <string>scrape:production</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gerard/Developer/carscraper</string>

  <!-- launchd starts with almost no PATH, and the task needs ssh, nc and mise. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/gerard/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Half past eight: after the droplet's seven o'clock round, so the two
       are not asking the same sites at the same moment. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/gerard/Developer/carscraper/log/scrape-production.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gerard/Developer/carscraper/log/scrape-production.log</string>
</dict>
</plist>
